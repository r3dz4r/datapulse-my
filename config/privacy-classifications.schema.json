{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataPulse MY privacy classification declarations",
  "type": "object",
  "required": [
    "schema",
    "classifications"
  ],
  "properties": {
    "schema": {"const": "datapulse/v1/privacy-classifications"},
    "classifications": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["classification", "basis", "reviewed_at", "reviewer"],
        "properties": {
          "classification": {"enum": ["no_personal_data"]},
          "basis": {"type": "string", "minLength": 1},
          "reviewed_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "reviewer": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
