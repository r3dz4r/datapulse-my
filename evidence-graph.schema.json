{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-pulse.my/evidence-graph.schema.json",
  "title": "DataPulse MY evidence-graph/v1",
  "type": "object",
  "required": ["schema", "graph_id", "generated_at", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "evidence-graph/v1"},
    "graph_id": {"$ref": "#/$defs/digest"},
    "generated_at": {"type": "string", "format": "date-time"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["fresh", "aging", "stale", "discontinued", "degraded", "browser_dependent", "unreachable", "unknown", "unknown_freshness", "reference"]},
    "node": {
      "oneOf": [
        {"$ref": "#/$defs/dataset"}, {"$ref": "#/$defs/observation"}, {"$ref": "#/$defs/receipt"}, {"$ref": "#/$defs/claim"}, {"$ref": "#/$defs/reconciliation"}
      ]
    },
    "dataset": {"type": "object", "additionalProperties": false, "required": ["id", "type", "dataset_id", "name", "source_url"], "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"const": "dataset"}, "dataset_id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1, "maxLength": 512}, "source_url": {"type": "string", "format": "uri", "maxLength": 2048}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["id", "type", "dataset_id", "observed_at", "status", "source_url", "fingerprint", "observation_digest"], "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"const": "observation"}, "dataset_id": {"$ref": "#/$defs/id"}, "observed_at": {"type": "string", "format": "date-time"}, "status": {"$ref": "#/$defs/status"}, "source_url": {"type": "string", "format": "uri", "maxLength": 2048}, "fingerprint": {"type": "string", "minLength": 1, "maxLength": 512}, "observation_digest": {"$ref": "#/$defs/digest"}}},
    "receipt": {"type": "object", "additionalProperties": false, "required": ["id", "type", "observation_id", "receipt_digest", "receipt_kind", "verification"], "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"const": "receipt"}, "observation_id": {"$ref": "#/$defs/id"}, "receipt_digest": {"$ref": "#/$defs/digest"}, "receipt_kind": {"enum": ["record-evidence", "attestation", "sigstore", "health"]}, "verification": {"enum": ["verified", "unverified", "unknown"]}}},
    "claim": {"type": "object", "additionalProperties": false, "required": ["id", "type", "observation_id", "claim_type", "text", "support", "evidence_digest"], "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"const": "claim"}, "observation_id": {"$ref": "#/$defs/id"}, "claim_type": {"type": "string", "minLength": 1, "maxLength": 128}, "text": {"type": "string", "minLength": 1, "maxLength": 2048}, "support": {"enum": ["supported", "partial", "unsupported", "unknown"]}, "evidence_digest": {"$ref": "#/$defs/digest"}}},
    "reconciliation": {"type": "object", "additionalProperties": false, "required": ["id", "type", "dataset_ids", "verdict", "basis"], "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"const": "reconciliation"}, "dataset_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "verdict": {"enum": ["agreement", "conflict", "incomparable", "unknown"]}, "basis": {"type": "string", "minLength": 1, "maxLength": 2048}}},
    "edge": {"type": "object", "additionalProperties": false, "required": ["id", "type", "from", "to"], "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["observes", "derived_from", "attested_by", "supports", "supersedes", "conflicts_with"]}, "from": {"$ref": "#/$defs/id"}, "to": {"$ref": "#/$defs/id"}}}
  }
}
