# Cloudflare Pages _headers for DataPulse MY
#
# Cloudflare Pages uses simple prefix matching per path-pattern block;
# glob syntax like /assets/** is not supported. Each block must declare
# its own rules and later rules override earlier ones for the same path.
#
# Goal: make brand assets cacheable for 24 hours at the browser edge
# (kills the cold-cache paint flash), HTML pages always revalidate
# (so deploys land instantly), JSON catalogues short-TTL (5 minutes),
# and apply baseline security headers across the whole site.

# --- Brand assets: 24 hour browser cache + edge cache --------------
/assets/
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff
  Vary: Accept-Encoding

/assets
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff
  Vary: Accept-Encoding

# --- Data surfaces: 10 minutes ------------------------------------
/data/jsonld/
  Cache-Control: public, max-age=600
  X-Content-Type-Options: nosniff
/data/
  Cache-Control: public, max-age=600
  X-Content-Type-Options: nosniff

# --- Health + manifest JSON: 5 minutes ----------------------------
/health/
  Cache-Control: public, max-age=300
  X-Content-Type-Options: nosniff
/datapulse.json
  Cache-Control: public, max-age=300
/mcp.json
  Cache-Control: public, max-age=300
/agent.json
  Cache-Control: public, max-age=300
/llms.txt
  Cache-Control: public, max-age=300
/datapulse.schema.json
  Cache-Control: public, max-age=3600
/health.schema.json
  Cache-Control: public, max-age=3600

# --- Static metadata: 1 hour ---------------------------------------
/sitemap.xml
  Cache-Control: public, max-age=3600
/feed.xml
  Cache-Control: public, max-age=600

# --- HTML pages: aggressive revalidate -----------------------------
/landing.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
/landing
  Cache-Control: public, max-age=0, must-revalidate
/build.html
  Cache-Control: public, max-age=0, must-revalidate
/build
  Cache-Control: public, max-age=0, must-revalidate
/npra.html
  Cache-Control: public, max-age=0, must-revalidate
/npra
  Cache-Control: public, max-age=0, must-revalidate
/learn.html
  Cache-Control: public, max-age=0, must-revalidate
/learn
  Cache-Control: public, max-age=0, must-revalidate
/dashboard.html
  Cache-Control: public, max-age=0, must-revalidate
/dashboard
  Cache-Control: public, max-age=0, must-revalidate
/health-methodology.html
  Cache-Control: public, max-age=0, must-revalidate
/health-methodology
  Cache-Control: public, max-age=0, must-revalidate
/agent-quickstart.md
  Cache-Control: public, max-age=0, must-revalidate
/agent-quickstart
  Cache-Control: public, max-age=0, must-revalidate

# --- Top-level: same -----------------------------------------------
/
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

# --- Security headers (applies to all responses) -------------------
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  X-Content-Type-Options: nosniff
