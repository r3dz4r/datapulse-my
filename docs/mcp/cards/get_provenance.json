  "description": "Return citation-ready provenance metadata for the listed dataset ids, plus compact pipeline-published evidence receipts: row probe time, HTTP status, request URL, access dependency, freshness source, content date, record count, shape fingerprint, anomaly flag, and status. Use when an agent must cite data and show the evidence behind the trust claim without recomputing it.",
  "displayName": "get_provenance",
  "endpoint": {
    "method": "POST",
    "transport": "streamable-http",
    "url": "https://mcp.data-pulse.my/mcp"
  },
  "identifier": "urn:air:data-pulse.my:mcp:get_provenance",
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "dataset_ids": {
        "description": "JSON array of 1 to 50 canonical dataset IDs, e.g. ['fuelprice', 'pricecatcher'].",
        "examples": [
          [
            "fuelprice",
            "pricecatcher"
          ]
        ],
        "items": {
          "type": "string"
        },
        "maxItems": 50,
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "dataset_ids"
    ],
    "type": "object"
  },
