[Unit]
Description=Run due DataPulse dataset health checks and publish changed artifacts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=redza
Group=redza
Environment=HOME=/home/redza
Environment=PATH=/home/redza/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/home/redza/datapulse-my
# Fix (2026-08-05): --autostash so a dirty worktree (uncommitted edits in
# /home/redza/datapulse-my/) doesn't silently abort the timer before the
# probe runs. /home/redza/datapulse-my is the SINGLE canonical checkout;
# Codex dispatches and hand-edits land here and the pull --autostash
# absorbs them before each probe.
ExecStartPre=/bin/bash -c 'set -e; if [[ ! -d /home/redza/datapulse-my/.git ]]; then echo "datapulse-health: repository missing: /home/redza/datapulse-my" >&2; exit 1; fi; cd /home/redza/datapulse-my; git pull --rebase --autostash'
# Fix (2026-08-05): added probe-start and probe-finish log lines so the
# timer is observable whether or not it produces artifacts. Both stdout
# (probe cycle count) and stderr (EHR messages) go to the same log file
# (StandardOutput/StandardError both append:/var/log/datapulse-health.err).
# Fix (2026-08-07): flock single-instance guard. At 375 datasets a full
# sweep can take ~7 min; if a tick ever outlives the 5-min timer window
# the next tick would collide on health/latest.json. flock -n makes a
# tick exit immediately (skip) when the previous probe still holds the
# lock. Lock file lives in /tmp (per-process, cleared on reboot).
ExecStart=/usr/bin/flock -n /tmp/datapulse-health.lock /bin/bash -c 'set -Eeuo pipefail; \
  health_tmp=$$(mktemp health/.latest.XXXXXX.json); \
  cleanup() { rm -f "$$health_tmp"; }; \
  trap cleanup EXIT; \
  trap '\''rc=$$?; echo "datapulse-health: failed (exit $$rc)" >&2'\'' ERR; \
  echo "datapulse-health: probe started at $$(date -Iseconds)"; \
  bash scripts/check.sh --due > "$$health_tmp"; \
  probed=$$(jq ".datasets | length" "$$health_tmp" 2>/dev/null || echo "?"); \
  jq -e . "$$health_tmp" >/dev/null; \
  mv "$$health_tmp" health/latest.json; \
  bash scripts/generate.sh health-cycle; \
  if [[ -z "$$(git status --porcelain -- health/ deltas/ badges/ feed.xml README.md catalog-snapshot.json changelog.json)" ]]; then \
    echo "datapulse-health: probe finished at $$(date -Iseconds); $$probed datasets probed; no artifact changes"; \
    exit 0; \
  fi; \
  echo "datapulse-health: probe finished at $$(date -Iseconds); $$probed datasets probed; artifacts changed, committing"; \
  git add health/ deltas/ badges/ feed.xml README.md catalog-snapshot.json changelog.json; \
  git -c user.name="Redza Halim" -c user.email="r3dz4r@gmail.com" commit -m "chore(health): update due dataset health"; \
  git pull --rebase --autostash; \
  git push origin HEAD:main; \
  echo "datapulse-health: pushed chore(health)"'
StandardOutput=append:/var/log/datapulse-health.err
StandardError=append:/var/log/datapulse-health.err
Nice=10
