{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.data-pulse.my/schemas/internal/probe-policy.schema.json",
  "title": "DataPulse internal probe policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "defaults", "datasets"],
  "properties": {
    "version": {"const": 1},
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "freshness-fallback"],
      "properties": {
        "adapter": {"const": "direct"},
        "freshness-fallback": {"const": "last-modified"}
      }
    },
    "templates": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9_-]*$"},
      "additionalProperties": {"$ref": "#/$defs/probe-template"}
    },
    "sg_static_metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "publisher", "frequency"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "frequency": {"type": "string", "minLength": 1}
        }
      }
    },
    "datasets": {
      "type": "object",
      "propertyNames": {"pattern": "^_?[a-z0-9][a-z0-9_-]*$"},
      "additionalProperties": {"$ref": "#/$defs/dataset-policy"}
    }
  },
  "$defs": {
    "adapter": {
      "enum": ["direct", "browser", "weather", "gtfs-static", "gtfs-realtime", "hansard-script", "st-energy", "arcgis-feature"]
    },
    "format": {
      "enum": ["csv", "json", "html", "xml", "pdf", "parquet"]
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extraction-mode", "fallback"],
      "properties": {
        "content-date-field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"
        },
        "extraction-mode": {
          "enum": ["max", "min", "first-row", "structural-hash"]
        },
        "family": {"type": "string"},
        "fallback": {"enum": ["last-modified", "unknown-freshness"]},
        "date-source": {"const": "data.gov.my-page"}
      },
      "allOf": [
        {
          "if": {"properties": {"extraction-mode": {"const": "structural-hash"}}},
          "then": {"not": {"required": ["content-date-field"]}},
          "else": {"required": ["content-date-field"]}
        }
      ]
    },
    "rolling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint-mode"],
      "properties": {
        "fingerprint-mode": {"const": "columns-only"}
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date-pattern", "wait-seconds"],
      "properties": {
        "date-pattern": {"type": "string", "minLength": 1, "maxLength": 500},
        "wait-seconds": {"type": "integer", "minimum": 1, "maximum": 120}
      }
    },
    "st-energy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow-id", "event-id", "report-kind", "content-date-source"],
      "properties": {
        "flow-id": {"type": "string", "pattern": "^[0-9]+$"},
        "event-id": {"enum": ["ViewStatisticELC1", "ViewStatisticELC2", "ViewStatisticELC3", "ViewStatisticELC6", "ViewStatisticELC9"]},
        "report-kind": {"enum": ["form-table", "pdf-links"]},
        "group-by": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
        "group-value": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
        "select-all-field": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
        "content-date-source": {"enum": ["table-year", "pdf-link-year"]}
      },
      "allOf": [
        {"if": {"properties": {"report-kind": {"const": "form-table"}}}, "then": {"required": ["select-all-field"], "properties": {"content-date-source": {"const": "table-year"}}}},
        {"if": {"required": ["group-by"]}, "then": {"required": ["group-value"]}},
        {"if": {"properties": {"report-kind": {"const": "pdf-links"}}}, "then": {"properties": {"event-id": {"const": "ViewStatisticELC1"}, "content-date-source": {"const": "pdf-link-year"}}}}
      ]
    },
    "dynamic-url": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template"],
      "properties": {
        "template": {
          "type": "string",
          "pattern": "^https://storage\\.data\\.gov\\.my/(?:pricecatcher/pricecatcher_\\{YYYY-MM\\}\\.parquet|transportation/(?:ktmb/(?:komuter|ets|intercity|komuter_utara|shuttle_tebrau)_\\{YYYY\\}\\.csv|(?:vehicles|cars|motorcycles)_\\{YYYY\\}\\.csv|bus/brt_\\{YYYY\\}_daily\\.csv|rail/rapidrail_\\{YYYY\\}_daily\\.csv))$"
        }
      }
    },
    "arcgis-feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed-host", "expected-layer-name", "required-fields", "allowed-fields", "timeout-seconds", "sample-limit", "max-response-bytes", "max-record-count"],
      "properties": {
        "allowed-host": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"},
        "expected-layer-name": {"type": "string", "minLength": 1},
        "required-fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "allowed-fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "timeout-seconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "sample-limit": {"type": "integer", "minimum": 1, "maximum": 100},
        "max-response-bytes": {"type": "integer", "minimum": 1024, "maximum": 10485760},
        "max-record-count": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "headers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"},
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
      }
    },
    "http-template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"const": "http"},
        "headers": {"$ref": "#/$defs/headers"},
        "freshness": {"$ref": "#/$defs/freshness"}
      }
    },
    "hansard-template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter"],
      "properties": {
        "adapter": {"const": "hansard-script"}
      }
    },
    "probe-template": {
      "oneOf": [
        {"$ref": "#/$defs/http-template"},
        {"$ref": "#/$defs/hansard-template"}
      ]
    },
    "dataset-policy": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "template": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "adapter": {"$ref": "#/$defs/adapter"},
        "format": {"$ref": "#/$defs/format"},
        "url": {"type": "string", "format": "uri"},
        "freshness": {"$ref": "#/$defs/freshness"},
        "rolling": {"$ref": "#/$defs/rolling"},
        "browser": {"$ref": "#/$defs/browser"},
        "st-energy": {"$ref": "#/$defs/st-energy"},
        "arcgis-feature": {"$ref": "#/$defs/arcgis-feature"},
        "dynamic-url": {"$ref": "#/$defs/dynamic-url"},
        "special-validator": {
          "enum": ["npra-registration-format", "npra-guidance-appendices"]
        }
      },
      "allOf": [
        {
          "if": {"required": ["browser"]},
          "then": {"required": ["adapter"], "properties": {"adapter": {"const": "browser"}}}
        },
        {
          "if": {"properties": {"adapter": {"const": "browser"}}, "required": ["adapter"]},
          "then": {"required": ["browser"]}
        },
        {
          "if": {"properties": {"adapter": {"const": "weather"}}, "required": ["adapter"]},
          "then": {"required": ["freshness"]}
        },
        {
          "if": {"properties": {"adapter": {"const": "st-energy"}}, "required": ["adapter"]},
          "then": {
            "required": ["st-energy", "freshness", "url"],
            "properties": {"url": {"const": "https://meih.st.gov.my/statistics"}}
          }
        }
        ,
        {
          "if": {"properties": {"adapter": {"const": "arcgis-feature"}}, "required": ["adapter"]},
          "then": {"required": ["arcgis-feature", "freshness"]}
        }
      ]
    }
  }
}
