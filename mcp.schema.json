{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataPulse MY MCP advertisement",
  "type": "object",
  "required": ["$schema", "schema", "mcp_version", "server", "endpoint", "taxonomy", "tools", "resources", "resource_templates"],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "schema": {"const": "datapulse/v1/mcp-advertisement"},
    "mcp_version": {"type": "string", "minLength": 1},
    "server": {
      "type": "object",
      "required": ["name", "version", "source_commit_sha", "source_commit_date", "description", "vendor", "homepage", "repository"],
      "properties": {
        "name": {"const": "DataPulse MY"}, "version": {"type": "string"},
        "source_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_commit_date": {"type": "string", "format": "date"},
        "description": {"type": "string"}, "vendor": {"type": "string"},
        "homepage": {"type": "string", "format": "uri"}, "repository": {"type": "string", "format": "uri"}
      },
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object", "required": ["url", "transport", "method", "auth_required"],
      "properties": {"url": {"type": "string", "format": "uri"}, "transport": {"const": "streamable-http"}, "method": {"const": "POST"}, "auth_required": {"const": false}},
      "additionalProperties": false
    },
    "taxonomy": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "tools": {"type": "array", "items": {"$ref": "#/$defs/tool"}},
    "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
    "resource_templates": {"type": "array", "items": {"$ref": "#/$defs/template"}}
  },
  "$defs": {
    "tool": {
      "type": "object", "required": ["name", "description", "inputSchema", "annotations"],
      "properties": {
        "name": {"type": "string"}, "description": {"type": ["string", "null"]}, "inputSchema": {"type": "object"},
        "annotations": {
          "type": "object", "required": ["readOnlyHint", "destructiveHint", "idempotentHint", "openWorldHint"],
          "properties": {"readOnlyHint": {"type": "boolean"}, "destructiveHint": {"type": "boolean"}, "idempotentHint": {"type": "boolean"}, "openWorldHint": {"type": "boolean"}},
          "additionalProperties": false
        }
      }, "additionalProperties": false
    },
    "resource": {
      "type": "object", "required": ["uri", "name", "description", "mimeType"],
      "properties": {"uri": {"type": "string"}, "name": {"type": "string"}, "description": {"type": ["string", "null"]}, "mimeType": {"type": "string"}}, "additionalProperties": false
    },
    "template": {
      "type": "object", "required": ["uriTemplate", "name", "description", "mimeType"],
      "properties": {"uriTemplate": {"type": "string"}, "name": {"type": "string"}, "description": {"type": ["string", "null"]}, "mimeType": {"type": "string"}}, "additionalProperties": false
    }
  },
  "additionalProperties": false
}
