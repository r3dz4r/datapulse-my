# DataPulse environment template — copy to .env and fill in your own keys.
# Keys marked real-required must be set; the rest are optional.
#
# .env is gitignored. Never commit real values; this file is committed as a
# reference for what each variable is for.

# --- Paddle (sandbox billing for NPRA paid plan) ----------------------------
PADDLE_ENVIRONMENT=sandbox
PADDLE_SANDBOX_API_KEY=your-paddle-sandbox-api-key-here
PADDLE_SANDBOX_CLIENT_TOKEN=your-paddle-sandbox-client-token-here
PADDLE_SANDBOX_PRODUCT_ID=your-paddle-sandbox-product-id-here
PADDLE_SANDBOX_PRICE_ID=your-paddle-sandbox-price-id-here
PADDLE_SANDBOX_WEBHOOK_SECRET=your-paddle-sandbox-webhook-secret-here

# --- OpenAI (used by OpenWiki workflow + local regeneration) ----------------
# API key (not ChatGPT OAuth). Get one at https://platform.openai.com/api-keys.
# The OpenWiki GitHub Actions workflow also reads this from
#   repo Settings -> Secrets -> Actions -> OPENAI_API_KEY
OPENAI_API_KEY=your-openai-api-key-here

# --- Operator override --------------------------------------------------------
# Add any other secrets below. Keep real values OUT of git.
