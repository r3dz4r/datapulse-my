{
  "schema": "datapulse/v1/answerability-benchmark",
  "cases": [
    {
      "name": "answerable_supported",
      "category": "answerable_supported",
      "request": {"dataset_id": "fuelprice", "scope": "latest retail fuel prices"},
      "evidence": [{"dataset_id": "fuelprice", "status": "fresh"}],
      "expected": {"action": "answer", "reason": "supported_evidence", "evidence_required": true}
    },
    {
      "name": "uncertain_freshness",
      "category": "uncertain_freshness",
      "request": {"dataset_id": "fuelprice", "scope": "latest retail fuel prices"},
      "evidence": [{"dataset_id": "fuelprice", "status": "unknown-freshness"}],
      "expected": {"action": "warn", "reason": "uncertain_freshness", "evidence_required": true}
    },
    {
      "name": "reference_only",
      "category": "reference_only",
      "request": {"dataset_id": "fuelprice", "scope": "source description"},
      "evidence": [{"dataset_id": "fuelprice", "status": "reference"}],
      "expected": {"action": "warn", "reason": "reference_only", "evidence_required": true}
    },
    {
      "name": "unsafe_status",
      "category": "unsafe_status",
      "request": {"dataset_id": "fuelprice", "scope": "latest retail fuel prices"},
      "evidence": [{"dataset_id": "fuelprice", "status": "stale"}],
      "expected": {"action": "abstain", "reason": "unsafe_evidence", "evidence_required": true}
    },
    {
      "name": "conflicting_evidence",
      "category": "conflicting_evidence",
      "request": {"dataset_id": "fuelprice", "scope": "latest retail fuel prices"},
      "evidence": [{"dataset_id": "fuelprice", "status": "fresh"}, {"dataset_id": "fuelprice", "status": "degraded"}],
      "expected": {"action": "abstain", "reason": "conflicting_evidence", "evidence_required": true}
    },
    {
      "name": "underspecified",
      "category": "underspecified",
      "request": {"scope": "latest retail fuel prices"},
      "evidence": [{"dataset_id": "fuelprice", "status": "fresh"}],
      "expected": {"action": "abstain", "reason": "underspecified", "evidence_required": true}
    },
    {
      "name": "out_of_catalogue",
      "category": "out_of_catalogue",
      "request": {"dataset_id": "not-a-datapulse-dataset", "scope": "latest value"},
      "evidence": [],
      "expected": {"action": "abstain", "reason": "no_supported_record", "evidence_required": true}
    },
    {
      "name": "as_of_current_fresh",
      "category": "temporal_current",
      "request": {"dataset_id": "blood_donations", "scope": "donation availability", "as_of_date": "2026-09-06T16:55:00Z"},
      "evidence": [
        {"dataset_id": "blood_donations", "status": "aging", "observed_at": "2026-08-30T17:15:00Z", "cycle": "20260830T1715Z", "shape_hash": "a4c8f173"},
        {"dataset_id": "blood_donations", "status": "fresh", "observed_at": "2026-09-06T16:55:00Z", "cycle": "20260906T1655Z", "shape_hash": "a4c8f173"}
      ],
      "expected": {"action": "answer", "reason": "supported_evidence", "evidence_required": true}
    },
    {
      "name": "as_of_historical_valid",
      "category": "temporal_historical",
      "request": {"dataset_id": "dgm_payments_transactions_fpx", "scope": "FPX payment transactions", "as_of_date": "2026-08-30T17:15:00Z"},
      "evidence": [
        {"dataset_id": "dgm_payments_transactions_fpx", "status": "fresh", "observed_at": "2026-08-30T17:15:00Z", "cycle": "20260830T1715Z", "shape_hash": "932ab80e"},
        {"dataset_id": "dgm_payments_transactions_fpx", "status": "stale", "observed_at": "2026-09-06T16:55:00Z", "cycle": "20260906T1655Z", "shape_hash": "932ab80e"}
      ],
      "expected": {"action": "answer", "reason": "historical_evidence", "evidence_required": true, "historical": true, "observed_at": "2026-08-30T17:15:00Z"}
    },
    {
      "name": "as_of_before_first_observation",
      "category": "temporal_unknown",
      "request": {"dataset_id": "bnm_kijang_emas", "scope": "Kijang Emas prices", "as_of_date": "2026-08-29"},
      "evidence": [
        {"dataset_id": "bnm_kijang_emas", "status": "stale", "observed_at": "2026-08-30T17:15:00Z", "cycle": "20260830T1715Z", "shape_hash": "77ba9c42"},
        {"dataset_id": "bnm_kijang_emas", "status": "aging", "observed_at": "2026-09-06T16:55:00Z", "cycle": "20260906T1655Z", "shape_hash": "77ba9c42"}
      ],
      "expected": {"action": "abstain", "reason": "no_supported_record", "evidence_required": true}
    },
    {
      "name": "stale_presented_as_current",
      "category": "temporal_unsafe",
      "request": {"dataset_id": "currency_in_circulation", "scope": "currency in circulation"},
      "evidence": [{"dataset_id": "currency_in_circulation", "status": "stale", "observed_at": "2026-09-06T16:55:00Z", "cycle": "20260906T1655Z", "shape_hash": "b0ee12f9"}],
      "expected": {"action": "abstain", "reason": "unsafe_evidence", "evidence_required": true}
    },
    {
      "name": "superseded_stale_selection",
      "category": "temporal_conflict",
      "request": {"dataset_id": "dgm_payments_transactions_fpx", "scope": "FPX payment transactions", "selected_observed_at": "2026-08-30T17:15:00Z"},
      "evidence": [
        {"dataset_id": "dgm_payments_transactions_fpx", "status": "stale", "observed_at": "2026-08-30T17:15:00Z", "cycle": "20260830T1715Z", "shape_hash": "932ab80e"},
        {"dataset_id": "dgm_payments_transactions_fpx", "status": "fresh", "observed_at": "2026-09-06T16:55:00Z", "cycle": "20260906T1655Z", "shape_hash": "932ab80e"}
      ],
      "expected": {"action": "abstain", "reason": "conflicting_evidence", "evidence_required": true}
    },
    {
      "name": "temporal_reference_only",
      "category": "temporal_reference",
      "request": {"dataset_id": "bnm_opr", "scope": "overnight policy rate", "as_of_date": "2026-09-06T16:55:00Z"},
      "evidence": [
        {"dataset_id": "bnm_opr", "status": "stale", "observed_at": "2026-08-30T17:15:00Z", "cycle": "20260830T1715Z", "shape_hash": "8facd2be"},
        {"dataset_id": "bnm_opr", "status": "reference", "observed_at": "2026-09-06T16:55:00Z", "cycle": "20260906T1655Z", "shape_hash": "8facd2be"}
      ],
      "expected": {"action": "warn", "reason": "reference_only", "evidence_required": true}
    },
    {
      "name": "temporal_uncertain",
      "category": "temporal_uncertain",
      "request": {"dataset_id": "bnm_kijang_emas", "scope": "Kijang Emas prices", "as_of_date": "2026-09-06T16:55:00Z"},
      "evidence": [
        {"dataset_id": "bnm_kijang_emas", "status": "stale", "observed_at": "2026-08-30T17:15:00Z", "cycle": "20260830T1715Z", "shape_hash": "77ba9c42"},
        {"dataset_id": "bnm_kijang_emas", "status": "aging", "observed_at": "2026-09-06T16:55:00Z", "cycle": "20260906T1655Z", "shape_hash": "77ba9c42"}
      ],
      "expected": {"action": "warn", "reason": "uncertain_freshness", "evidence_required": true}
    },
    {
      "name": "future_as_of_date",
      "category": "temporal_future",
      "request": {"dataset_id": "blood_donations", "scope": "donation availability", "as_of_date": "2026-09-07T00:00:00Z"},
      "evidence": [
        {"dataset_id": "blood_donations", "status": "aging", "observed_at": "2026-08-30T17:15:00Z", "cycle": "20260830T1715Z", "shape_hash": "a4c8f173"},
        {"dataset_id": "blood_donations", "status": "fresh", "observed_at": "2026-09-06T16:55:00Z", "cycle": "20260906T1655Z", "shape_hash": "a4c8f173"}
      ],
      "expected": {"action": "answer", "reason": "supported_evidence", "evidence_required": true, "as_of_beyond_latest": true}
    },
    {
      "name": "claim_supported_use",
      "category": "claim_support",
      "claim": "The fuel price dataset was reachable on the observation date.",
      "claim_type": "availability_observed",
      "asserted": {"observed_at": "2026-09-06T16:55:00Z"},
      "citation": {"dataset_id": "fuelprice", "observed_at": "2026-09-06T16:55:00Z", "datapulse_verdict": "USE"},
      "expected": {"action": "answer", "reason": "supported_claim", "evidence_required": true, "claim_verdict": "supported"}
    },
    {
      "name": "claim_partial_warn",
      "category": "claim_support",
      "claim": "The fuel price dataset status was aging.",
      "claim_type": "status_observed",
      "asserted": {"status": "aging"},
      "citation": {"dataset_id": "fuelprice", "status": "aging", "datapulse_verdict": "WARN"},
      "expected": {"action": "warn", "reason": "partial_claim", "evidence_required": true, "claim_verdict": "partial"}
    },
    {
      "name": "claim_unsupported_stop",
      "category": "claim_support",
      "claim": "The fuel price dataset status was stale.",
      "claim_type": "status_observed",
      "asserted": {"status": "stale"},
      "citation": {"dataset_id": "fuelprice", "status": "stale", "datapulse_verdict": "STOP"},
      "expected": {"action": "abstain", "reason": "unsupported_claim", "evidence_required": true, "claim_verdict": "unsupported"}
    },
    {
      "name": "claim_semantic_truth_blocked",
      "category": "claim_support",
      "claim": "The data is accurate.",
      "claim_type": "semantic_truth",
      "asserted": {},
      "citation": {"dataset_id": "fuelprice", "datapulse_verdict": "USE"},
      "expected": {"action": "abstain", "reason": "outside_evidence_scope", "evidence_required": true, "claim_verdict": "unsupported"}
    },
    {
      "name": "claim_licence_supported",
      "category": "claim_support",
      "claim": "The citation provides licence evidence.",
      "claim_type": "licence_evidence",
      "asserted": {"licence": "Open Data"},
      "citation": {"dataset_id": "fuelprice", "licence": "Open Data", "datapulse_verdict": "USE"},
      "expected": {"action": "answer", "reason": "supported_claim", "evidence_required": true, "claim_verdict": "supported"}
    },
    {
      "name": "claim_licence_unobserved",
      "category": "claim_support",
      "claim": "The citation provides licence evidence.",
      "claim_type": "licence_evidence",
      "asserted": {"licence": "Open Data"},
      "citation": {"dataset_id": "fuelprice", "datapulse_verdict": "USE"},
      "expected": {"action": "abstain", "reason": "licence_unobserved", "evidence_required": true, "claim_verdict": "unknown"}
    },
    {
      "name": "claim_malformed_citation",
      "category": "claim_support",
      "claim": "The fuel price dataset was reachable on the observation date.",
      "claim_type": "availability_observed",
      "asserted": {"observed_at": "2026-09-06T16:55:00Z"},
      "citation": null,
      "expected": {"action": "abstain", "reason": "malformed_citation", "evidence_required": true, "claim_verdict": "unknown"}
    },
    {
      "name": "claim_unclassified_type",
      "category": "claim_support",
      "claim": "The fuel price dataset is popular.",
      "claim_type": "popularity",
      "asserted": {},
      "citation": {"dataset_id": "fuelprice", "datapulse_verdict": "USE"},
      "expected": {"action": "abstain", "reason": "unclassified_claim", "evidence_required": true, "claim_verdict": "unknown"}
    },
    {
      "name": "claim_overclaim_degrade",
      "category": "claim_support",
      "claim": "The authoritative fuel price dataset was reachable on the observation date.",
      "claim_type": "availability_observed",
      "asserted": {"observed_at": "2026-09-06T16:55:00Z"},
      "citation": {"dataset_id": "fuelprice", "observed_at": "2026-09-06T16:55:00Z", "datapulse_verdict": "USE"},
      "expected": {"action": "warn", "reason": "overclaim", "evidence_required": true, "claim_verdict": "partial"}
    }
  ]
}
