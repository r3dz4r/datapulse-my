{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.data-pulse.my/passport.schema.json",
  "title": "DataPulse Dataset Passport v1",
  "type": "object",
  "required": ["schema", "identity", "intended_use", "licence_and_attribution", "health_evidence", "quality_profile", "reproducibility_and_evidence", "lineage", "record_evidence", "sensitivity_and_pii", "limitations"],
  "properties": {
    "schema": {"const": "datapulse/v1/dataset-passport"},
    "identity": {"$ref": "#/$defs/identity"},
    "intended_use": {"$ref": "#/$defs/intendedUse"},
    "licence_and_attribution": {"$ref": "#/$defs/licence"},
    "health_evidence": {"$ref": "#/$defs/health"},
    "quality_profile": {"$ref": "#/$defs/qualityProfile"},
    "reproducibility_and_evidence": {"$ref": "#/$defs/reproducibility"},
    "lineage": {"$ref": "#/$defs/lineage"},
    "record_evidence": {"$ref": "#/$defs/recordEvidence"},
    "sensitivity_and_pii": {"$ref": "#/$defs/unavailable"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "additionalProperties": false,
  "$defs": {
    "unavailable": {"type": "object", "required": ["state", "reason"], "properties": {"state": {"enum": ["not_evaluated", "unknown"]}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "nullableString": {"type": ["string", "null"]},
    "reference": {"type": "string", "minLength": 1, "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._/-]*|https://[^\\s]+)$"},
    "digest": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-f]{64}$"},
    "identity": {"type": "object", "required": ["dataset_id", "name", "source", "steward", "custodian", "canonical_url", "namespace", "geography", "declared_verified_at", "observed_verified_at"], "properties": {"dataset_id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "source": {"$ref": "#/$defs/nullableString"}, "steward": {"$ref": "#/$defs/nullableString"}, "custodian": {"$ref": "#/$defs/nullableString"}, "canonical_url": {"type": "string", "format": "uri"}, "namespace": {"$ref": "#/$defs/nullableString"}, "geography": {"$ref": "#/$defs/nullableString"}, "declared_verified_at": {"type": ["string", "null"], "format": "date"}, "observed_verified_at": {"type": ["string", "null"], "format": "date-time"}}, "additionalProperties": false},
    "intendedUse": {"type": "object", "required": ["declared_purpose", "declared_coverage"], "properties": {"declared_purpose": {"oneOf": [{"$ref": "#/$defs/unavailable"}, {"type": "string", "minLength": 1}]}, "declared_coverage": {"oneOf": [{"$ref": "#/$defs/unavailable"}, {"type": "object", "required": ["geography"], "properties": {"geography": {"type": "string", "minLength": 1}}, "additionalProperties": false}]}}, "additionalProperties": false},
    "licence": {"type": "object", "required": ["declared_licence", "licence_url", "attribution", "limitation"], "properties": {"declared_licence": {"$ref": "#/$defs/nullableString"}, "licence_url": {"type": ["string", "null"], "format": "uri"}, "attribution": {"$ref": "#/$defs/nullableString"}, "limitation": {"const": "Declared metadata and evidence only; not legal advice or legal permission."}}, "additionalProperties": false},
    "health": {"type": "object", "required": ["status", "last_checked", "freshness_signal", "freshness_signal_source", "record_count", "expected_record_count", "record_count_estimated", "incomplete", "http_status", "access_method", "access_dependency", "schema_shape", "anomaly_reliability"], "properties": {"status": {"enum": ["fresh", "aging", "stale", "discontinued", "degraded", "browser-dependent", "unreachable", "unknown", "unknown-freshness", "reference"]}, "last_checked": {"type": ["string", "null"], "format": "date-time"}, "freshness_signal": {"$ref": "#/$defs/nullableString"}, "freshness_signal_source": {"$ref": "#/$defs/nullableString"}, "record_count": {"type": ["integer", "null"], "minimum": 0}, "expected_record_count": {"type": ["integer", "null"], "minimum": 0}, "record_count_estimated": {"type": ["boolean", "null"]}, "incomplete": {"type": ["boolean", "null"]}, "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599}, "access_method": {"$ref": "#/$defs/nullableString"}, "access_dependency": {"$ref": "#/$defs/nullableString"}, "schema_shape": {"type": "object", "required": ["column_count", "first_row_hash", "content_shape_changed"], "properties": {"column_count": {"type": ["integer", "null"], "minimum": 0}, "first_row_hash": {"$ref": "#/$defs/nullableString"}, "content_shape_changed": {"type": ["boolean", "null"]}}, "additionalProperties": false}, "anomaly_reliability": {"type": "object", "required": ["anomaly_detected", "anomaly_detection"], "properties": {"anomaly_detected": {"type": ["boolean", "null"]}, "anomaly_detection": {"type": ["object", "null"]}}, "additionalProperties": false}}, "additionalProperties": false},
    "qualityProfile": {"type": "object", "required": ["profile_version", "policy_id", "overall", "dimensions"], "properties": {"profile_version": {"const": "datapulse-quality-profile/v1"}, "policy_id": {"const": "datapulse-quality-readiness/v1"}, "overall": {"enum": ["ready", "indeterminate", "not_ready"]}, "dimensions": {"type": "object", "required": ["fair", "licensing", "provenance", "governance", "reproducibility", "catalogue_readiness"], "additionalProperties": true}}, "additionalProperties": true},
    "reproducibility": {"type": "object", "required": ["verification_method", "source_envelope", "source_digest", "attestation", "chain_reference", "witness_reference"], "properties": {"verification_method": {"const": "deterministic_local_projection_of_current_canonical_inputs"}, "source_envelope": {"oneOf": [{"$ref": "#/$defs/unavailable"}, {"$ref": "#/$defs/reference"}]}, "source_digest": {"oneOf": [{"$ref": "#/$defs/unavailable"}, {"$ref": "#/$defs/digest"}]}, "attestation": {"oneOf": [{"$ref": "#/$defs/unavailable"}, {"$ref": "#/$defs/reference"}]}, "chain_reference": {"oneOf": [{"$ref": "#/$defs/unavailable"}, {"$ref": "#/$defs/reference"}]}, "witness_reference": {"$ref": "#/$defs/unavailable"}}, "additionalProperties": false},
    "lineage": {"type": "object", "required": ["catalogue_relationships", "transformation_lineage"], "properties": {"catalogue_relationships": {"type": "object", "required": ["graph_reference", "relationship_edges", "limitation"], "properties": {"graph_reference": {"$ref": "#/$defs/reference"}, "relationship_edges": {"type": "array", "items": {"type": "object", "required": ["kind", "from", "to", "weight", "provenance"], "properties": {"kind": {"type": "string", "minLength": 1}, "from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}, "weight": {"type": "integer", "minimum": 0}, "provenance": {"type": "object"}}, "additionalProperties": false}}, "limitation": {"const": "Catalogue relationships are literal metadata context, not full transformation lineage."}}, "additionalProperties": false}, "transformation_lineage": {"$ref": "#/$defs/unavailable"}}, "additionalProperties": false},
    "recordEvidence": {"oneOf": [{"$ref": "#/$defs/unavailable"}, {"type": "object", "required": ["schema", "reference", "dataset_id"], "properties": {"schema": {"const": "record-evidence/v1"}, "reference": {"$ref": "#/$defs/reference"}, "dataset_id": {"type": "string", "minLength": 1}}, "additionalProperties": false}]}
  }
}
