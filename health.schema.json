{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r3dz4r.github.io/datapulse-my/health.schema.json",
  "title": "DataPulse MY dataset health snapshot",
  "type": "object",
  "required": ["schema", "checked_at", "_trust_summary", "datasets"],
  "properties": {
    "schema": {
      "const": "datapulse/v0.4/dataset-health"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "_trust_summary": {
      "type": "object",
      "required": ["checked_at", "datasets_total", "by_status"],
      "properties": {
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "datasets_total": {
          "type": "integer",
          "minimum": 1
        },
        "by_status": {
          "type": "object",
          "required": [
            "fresh",
            "aging",
            "stale",
            "discontinued",
            "degraded",
            "browser_dependent",
            "unreachable",
            "unknown",
            "unknown_freshness",
            "reference"
          ],
          "properties": {
            "fresh": {"type": "integer", "minimum": 0},
            "aging": {"type": "integer", "minimum": 0},
            "stale": {"type": "integer", "minimum": 0},
            "discontinued": {"type": "integer", "minimum": 0},
            "degraded": {"type": "integer", "minimum": 0},
            "browser_dependent": {"type": "integer", "minimum": 0},
            "unreachable": {"type": "integer", "minimum": 0},
            "unknown": {"type": "integer", "minimum": 0},
            "unknown_freshness": {"type": "integer", "minimum": 0},
            "reference": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dataset_id", "last_checked", "url", "status"],
        "properties": {
          "dataset_id": {
            "type": "string",
            "minLength": 1
          },
          "last_checked": {
            "type": "string",
            "format": "date-time"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "status": {
            "type": "string",
            "enum": [
              "fresh",
              "aging",
              "stale",
              "discontinued",
              "degraded",
              "browser-dependent",
              "unreachable",
              "unknown",
              "unknown-freshness",
              "reference"
            ]
          },
          "anomaly_detected": {
            "type": "boolean"
          },
          "anomaly_detection": {
            "type": "object",
            "required": ["metric", "mode", "window_days", "sample_days", "mean_days", "stdev_days", "threshold_days", "latest_days"],
            "properties": {
              "metric": {"const": "freshness_delta_days"},
              "mode": {"enum": ["rolling_14d", "cadence_fallback", "not_evaluated"]},
              "window_days": {"const": 14},
              "sample_days": {"type": "integer", "minimum": 0, "maximum": 14},
              "mean_days": {"type": ["number", "null"], "minimum": 0},
              "stdev_days": {"type": ["number", "null"], "minimum": 0},
              "threshold_days": {"type": ["number", "null"], "minimum": 0},
              "latest_days": {"type": ["number", "null"], "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
