{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r3dz4r.github.io/datapulse-my/health.schema.json",
  "title": "DataPulse MY dataset health snapshot",
  "type": "object",
  "required": ["schema", "checked_at", "_trust_summary", "datasets"],
  "properties": {
    "schema": {
      "const": "datapulse/v0.4/dataset-health"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "_trust_summary": {
      "type": "object",
      "required": ["checked_at", "datasets_total", "by_status"],
      "properties": {
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "datasets_total": {
          "type": "integer",
          "minimum": 1
        },
        "by_status": {
          "type": "object",
          "required": [
            "fresh",
            "aging",
            "stale",
            "discontinued",
            "degraded",
            "browser_dependent",
            "unreachable",
            "unknown",
            "unknown_freshness",
            "reference"
          ],
          "properties": {
            "fresh": {"type": "integer", "minimum": 0},
            "aging": {"type": "integer", "minimum": 0},
            "stale": {"type": "integer", "minimum": 0},
            "discontinued": {"type": "integer", "minimum": 0},
            "degraded": {"type": "integer", "minimum": 0},
            "browser_dependent": {"type": "integer", "minimum": 0},
            "unreachable": {"type": "integer", "minimum": 0},
            "unknown": {"type": "integer", "minimum": 0},
            "unknown_freshness": {"type": "integer", "minimum": 0},
            "reference": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dataset_id", "last_checked", "url", "status"],
        "properties": {
          "dataset_id": {
            "type": "string",
            "minLength": 1
          },
          "last_checked": {
            "type": "string",
            "format": "date-time"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "status": {
            "type": "string",
            "enum": [
              "fresh",
              "aging",
              "stale",
              "discontinued",
              "degraded",
              "browser-dependent",
              "unreachable",
              "unknown",
              "unknown-freshness",
              "reference"
            ]
          },
          "schema_fingerprint": {
            "type": ["string", "null"],
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "shape_basis": {
            "type": ["string", "null"],
            "enum": ["json-array", "json-object", "csv-headers", "archive-member-headers", "untyped", null]
          },
          "quality_profile": {
            "description": "Additive, evidence-bounded six-dimension metadata readiness profile. It is not a semantic-quality score or certification.",
            "type": "object",
            "required": ["profile_version", "policy_id", "dimensions", "overall", "limitations"],
            "properties": {
              "profile_version": {"const": "datapulse-quality-profile/v1"},
              "policy_id": {"const": "datapulse-quality-readiness/v1"},
              "dimensions": {
                "type": "object",
                "required": ["fair", "licensing", "provenance", "governance", "reproducibility", "catalogue_readiness"],
                "properties": {
                  "fair": {"$ref": "#/$defs/qualityDimension"},
                  "licensing": {"$ref": "#/$defs/qualityDimension"},
                  "provenance": {"$ref": "#/$defs/qualityDimension"},
                  "governance": {"$ref": "#/$defs/qualityDimension"},
                  "reproducibility": {"$ref": "#/$defs/qualityDimension"},
                  "catalogue_readiness": {"$ref": "#/$defs/qualityDimension"}
                },
                "additionalProperties": false
              },
              "overall": {"enum": ["ready", "not_ready", "indeterminate"]},
              "limitations": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          },
          "sample_rows": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "active_rows": {
            "type": ["object", "null"],
            "additionalProperties": {"type": "integer", "minimum": 0}
          },
          "anomaly_detected": {
            "type": "boolean"
          },
          "anomaly_detection": {
            "type": "object",
            "required": ["metric", "mode", "window_days", "sample_days", "mean_days", "stdev_days", "threshold_days", "latest_days"],
            "properties": {
              "metric": {"const": "freshness_delta_days"},
              "mode": {"enum": ["rolling_14d", "cadence_fallback", "not_evaluated"]},
              "window_days": {"const": 14},
              "sample_days": {"type": "integer", "minimum": 0, "maximum": 14},
              "mean_days": {"type": ["number", "null"], "minimum": 0},
              "stdev_days": {"type": ["number", "null"], "minimum": 0},
              "threshold_days": {"type": ["number", "null"], "minimum": 0},
              "latest_days": {"type": ["number", "null"], "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "qualityEvidenceRef": {
      "type": "object",
      "required": ["source", "path"],
      "properties": {
        "source": {"enum": ["manifest", "health"]},
        "path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "qualityCheck": {
      "type": "object",
      "required": ["check_id", "state", "reason_codes", "evidence_refs", "limitations"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^[a-z_]+\\.[a-z0-9_]+$"},
        "state": {"enum": ["pass", "fail", "unknown", "not_applicable"]},
        "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/qualityEvidenceRef"}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "qualityDimension": {
      "type": "object",
      "required": ["state", "checks", "coverage", "reason_codes", "evidence_refs", "limitations", "policy_basis"],
      "properties": {
        "state": {"enum": ["pass", "fail", "unknown", "not_applicable"]},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/qualityCheck"}},
        "coverage": {
          "type": "object",
          "required": ["applicable", "evaluated", "passed", "failed", "unknown", "not_applicable"],
          "properties": {
            "applicable": {"type": "integer", "minimum": 0},
            "evaluated": {"type": "integer", "minimum": 0},
            "passed": {"type": "integer", "minimum": 0},
            "failed": {"type": "integer", "minimum": 0},
            "unknown": {"type": "integer", "minimum": 0},
            "not_applicable": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/qualityEvidenceRef"}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "policy_basis": {"const": "datapulse-quality-readiness/v1"}
      },
      "additionalProperties": false
    }
  }
}
